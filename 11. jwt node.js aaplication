<!DOCTYPE html>
<html>
<head>
    <title>Online Exam Portal</title>
    <style>
        body {
            font-family: Arial;
            background-color: #f2f2f2;
            text-align: center;
            margin-top: 40px;
        }
        .container {
            background: white;
